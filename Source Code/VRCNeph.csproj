<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DebugType>none</DebugType>
    <AssemblyName>VRCNeph</AssemblyName>
    <Title>VRCNeph</Title>
    <Product>VRCNeph</Product>
    <Description>Desktop app for managing VRChat avatar favorites, groups, notes, syncing, and database search.</Description>
    <Company>VRCNeph</Company>
    <Authors>VRCNeph</Authors>
    <Copyright></Copyright>
    <Version>1.0.31</Version>
    <AssemblyVersion>$(Version).0</AssemblyVersion>
    <FileVersion>$(Version).0</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <UseWindowsForms>true</UseWindowsForms>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <ApplicationIcon>src\App\VRCNeph.ico</ApplicationIcon>
    <PublishDir>$(MSBuildProjectDirectory)\artifacts\publish\</PublishDir>
    <RootExecutablePath Condition="'$([System.IO.Path]::GetFileName($(MSBuildProjectDirectory)))' == 'Source Code'">$(MSBuildProjectDirectory)\..\VRCNeph.exe</RootExecutablePath>
    <RootExecutablePath Condition="'$([System.IO.Path]::GetFileName($(MSBuildProjectDirectory)))' == 'Source'">$(MSBuildProjectDirectory)\..\VRCNeph.exe</RootExecutablePath>
    <RootExecutablePath Condition="'$(RootExecutablePath)' == ''">$(MSBuildProjectDirectory)\VRCNeph.exe</RootExecutablePath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="old builds\**\*.cs" />
    <Compile Remove="Source\**\*.cs" />
    <EmbeddedResource Remove="old builds\**\*" />
    <EmbeddedResource Remove="Source\**\*" />
    <None Remove="old builds\**\*" />
    <None Remove="Source\**\*" />
    <Content Remove="old builds\**\*" />
    <Content Remove="Source\**\*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.7" />
    <PackageReference Include="Photino.NET" Version="4.0.16" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="src\App\**\*" />
  </ItemGroup>

  <Target Name="PublishRootExecutable" AfterTargets="Build">
    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="Publish" Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);PublishDir=$(MSBuildProjectDirectory)\artifacts\publish\;NoBuild=true" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\artifacts\publish\VRCNeph.exe" DestinationFiles="$(RootExecutablePath)" />
  </Target>

  <Target Name="ValidateVersionContract" BeforeTargets="BeforeBuild">
    <Error Condition="'$(InformationalVersion)' != '$(Version)'" Text="InformationalVersion must match Version so the in-app updater reports the installed build correctly." />
    <Error Condition="'$(AssemblyVersion)' != '$(Version).0'" Text="AssemblyVersion must match Version with a trailing revision component." />
    <Error Condition="'$(FileVersion)' != '$(Version).0'" Text="FileVersion must match Version with a trailing revision component." />
  </Target>

</Project>
